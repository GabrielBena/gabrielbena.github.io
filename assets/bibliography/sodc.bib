	note = {arXiv:2402.10793 [cs]},
	keywords = {Computer Science - Machine Learning, Computer Science - Artificial Intelligence},
	pages = {5244},
	annote = {Comment: Now published in Nature Communications},
	file = {Preprint PDF:/Users/bary/Zotero/storage/H2ZAC334/Buterez et al. - 2025 - An end-to-end attention-based approach for learning on graphs.pdf:application/pdf;Snapshot:/Users/bary/Zotero/storage/P28DP43N/2402.html:text/html},
}

@inproceedings{zhou_graceful_2007,
